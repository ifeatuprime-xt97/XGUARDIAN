{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm install --frozen-lockfile && pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/trpc/(.*)",
      "destination": "/api/trpc/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
