# Local runtime. Do not set NODE_ENV on Vercel; the platform sets it.
PORT=3000

# Server-only anonymous device backup (Neon pooled connection at runtime)
NEON_DATABASE_URL=

# Server-only optional AI explanation provider.
# Without this, /api/trpc/guardian.explain returns deterministic fallback wording.
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# Explicit opt-in only: runs the networked Gemini integration test
RUN_GEMINI_LIVE_TEST=0

# Explicit opt-in only: validates a live Neon migration and device-state round trip
RUN_NEON_LIVE_TEST=0

# Optional public X Layer RPC overrides. Never put credentials in VITE_* values.
VITE_XLAYER_MAINNET_RPC_URL=
VITE_XLAYER_TESTNET_RPC_URL=
VITE_XLAYER_REPUTATION_API_URL=
